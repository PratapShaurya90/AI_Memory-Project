// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Tell Prisma to connect to Postgres and enable the vector extension!
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("POSTGRES_URI")
  extensions = [vector] // This turns Postgres into Pinecone!
}

// ---------------------------------------------------
// 🧱 BLOCK 1: LONG-TERM MEMORY (The Facts)
// ---------------------------------------------------
model LongTermMemory {
  id         Int      @id @default(autoincrement())
  
  // We use String for userId because your MongoDB Auth uses String ObjectIds!
  userId     String   
  
  fact       String   // Example: "User prefers React"
  confidence Float?   // Example: 0.95
  
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------
// 🧱 BLOCK 2: REFERENCE MEMORY (The Vector Search)
// ---------------------------------------------------
model ReferenceMemory {
  id               Int      @id @default(autoincrement())
  
  userId           String
  
  summary          String   // The text summary of the chat
  
  // The OpenAI math array (1536 dimensions) for semantic search
  embedding        Unsupported("vector(1536)") 
  
  // The pointer to your MongoDB raw chat logs!
  originalMemoryId String   
  
  createdAt        DateTime @default(now())
}
